# Required
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Strongly recommended (Places API (New) + Routes API enabled). Without it: OpenStreetMap + estimated travel.
GOOGLE_MAPS_API_KEY=
# Recommended: web search for local favourites, transport & holiday info
TAVILY_API_KEY=
# Optional traffic fallback if Google Routes is unavailable
TOMTOM_API_KEY=

# Production knobs
LOG_FORMAT=text          # json in production
LOG_LEVEL=INFO
PLAN_RATE_LIMIT=6/600    # plans per IP per window (seconds)
DAILY_PLAN_LIMIT=300     # protects your API quotas
MAX_CONCURRENT_PLANS=4
